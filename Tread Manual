export default function TreadManual() {
  const [selectedItem, setSelectedItem] = useState(null);
  const [selectedSubItem, setSelectedSubItem] = useState(null);

  const handleMenuClick = useCallback((item) => {
    setSelectedItem((prev) => (prev === item ? null : item));
    setSelectedSubItem(null);
  }, []);

  const handleSubMenuClick = useCallback((subItem) => {
    setSelectedSubItem(subItem);
  }, []);

  return (
    <div className="flex h-screen bg-black text-green-300 font-mono">
      <div className="w-1/4 bg-gray-900 text-white p-4 border-r-4 border-green-500 shadow-xl">
        <h1 className="text-xl font-bold text-green-400 mb-4">TREAD Manual</h1>
        {Object.keys(menuItems).map((item) => (
          <div key={item}>
            <button
              className="w-full text-left p-2 hover:bg-green-700 transition duration-300"
              onClick={() => handleMenuClick(item)}
            >
              {item}
            </button>
            <AnimatePresence>
              {selectedItem === item && menuItems[item].subItems && (
                <motion.div
                  initial={{ opacity: 0, height: 0 }}
                  animate={{ opacity: 1, height: "auto" }}
                  exit={{ opacity: 0, height: 0 }}
                  className="ml-4 border-l-2 border-green-500 pl-2"
                >
                  {Object.keys(menuItems[item].subItems).map((subItem) => (
                    <button
                      key={subItem}
                      className="w-full text-left p-2 hover:bg-green-600 transition duration-300"
                      onClick={() => handleSubMenuClick(subItem)}
                    >
                      {subItem}
                    </button>
                  ))}
                </motion.div>
              )}
            </AnimatePresence>
          </div>
        ))}
      </div>
      <div className="w-3/4 p-6 bg-gray-800 text-green-200 border-l-4 border-green-500 shadow-lg">
        <AnimatePresence mode="wait">
          {selectedSubItem ? (
            <motion.p
              key={selectedSubItem}
              initial={{ opacity: 0, y: 10 }}
              animate={{ opacity: 1, y: 0 }}
              exit={{ opacity: 0, y: -10 }}
              className="text-lg font-semibold"
            >
              {menuItems[selectedItem].subItems[selectedSubItem]}
            </motion.p>
          ) : selectedItem ? (
            <motion.p
              key={selectedItem}
              initial={{ opacity: 0, y: 10 }}
              animate={{ opacity: 1, y: 0 }}
              exit={{ opacity: 0, y: -10 }}
              className="text-lg font-semibold"
            >
              {menuItems[selectedItem].manual || menuItems[selectedItem]}
            </motion.p>
          ) : (
            <motion.p
              initial={{ opacity: 0, y: 10 }}
              animate={{ opacity: 1, y: 0 }}
              exit={{ opacity: 0, y: -10 }}
              className="text-lg font-semibold text-green-400"
            >
              Select an option to view its manual.
            </motion.p>
          )}
        </AnimatePresence>
      </div>
    </div>
  );
}
